# Google Generative AI API key (Gemini) - Get yours at: https://makersuite.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Database connection string (Vercel Postgres, Supabase, or PlanetScale)
POSTGRES_URL=postgresql://user:password@host:5432/database

# Redis/KV for job queue (optional - for production deployment)
REDIS_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Worker configuration
PARALLEL_WORKERS=3
RETRY_ATTEMPTS=3
SCRAPE_DELAY_MS=2000
TARGET_URL=https://innovation.ised-isde.canada.ca/innovation/s/list-liste?language=fr_CA&token=a0BMm00000612cDMAQ

# Worker webhook URL (for triggering external worker)
WORKER_WEBHOOK_URL=
